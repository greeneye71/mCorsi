# Generare un valore lungo e casuale prima della messa in produzione.
MCORSI_ENV=production
MCORSI_SECRET_KEY=cambia-questo-valore
MCORSI_ENCRYPTION_KEY=usa-un-secondo-valore-lungo-e-casuale
# Solo durante una rotazione; rimuovere dopo il comando amministrativo.
# MCORSI_ENCRYPTION_PREVIOUS_KEYS=chiave-fernet-precedente
# Solo per migrare le cifrature precedenti alla versione 0.5.4.
# MCORSI_LEGACY_ENCRYPTION_KEY=vecchio-valore-di-MCORSI_ENCRYPTION_KEY
MCORSI_OTP_PEPPER=usa-un-terzo-valore-lungo-e-casuale
MCORSI_MCP_TOKEN_PEPPER=usa-un-quarto-valore-lungo-e-casuale

# Un solo indirizzo e una sola porta web, usati in sviluppo e produzione.
MCORSI_WEB_HOST=127.0.0.1
MCORSI_WEB_PORT=5100
# Attivare solo se la porta applicativa accetta traffico esclusivamente dal reverse proxy.
# MCORSI_TRUST_PROXY_HEADERS=true
MCORSI_MCP_PORT=8001

# Le directory possono essere assolute sia su Windows sia su Linux.
# MCORSI_DATABASE_URL=sqlite:///C:/percorso/mcorsi.sqlite3
# MCORSI_STORAGE_PATH=C:/percorso/storage
# MCORSI_BACKUP_PATH=D:/backup/mcorsi
# MCORSI_BACKUP_RETENTION_COUNT=30
# MCORSI_MAX_UPLOAD_BYTES=20971520
# MCORSI_LIBREOFFICE_PATH=C:/Program Files/LibreOffice/program/soffice.exe

# Server MCP separato, sempre dietro Cloudflare Tunnel.
# MCORSI_MCP_PUBLIC_URL=https://mcp.example.it/mcp
# MCORSI_MCP_HOST=127.0.0.1
# MCORSI_MCP_ALLOWED_HOSTS=mcp.example.it,127.0.0.1:8001,localhost:8001
# MCORSI_MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://claude.ai
